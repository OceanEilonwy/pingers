{
  "name": "push-token-plaintext",
  "description": "Sealed push plaintext: version || platform || class || be64(not_after) || be16(len) || token, zero-padded to 272 bytes (design B.4.9)",
  "vectors": [
    {
      "name": "fcm-standard",
      "inputs": {
        "platform": "fcm",
        "class": "standard",
        "token": "66636d2d746f6b656e3a303132333435363738393a3b3c3d3e3f40414243",
        "not_after": 1790000000
      },
      "expected": {
        "padded": ""
      }
    },
    {
      "name": "unified-push-location",
      "inputs": {
        "platform": "unified_push",
        "class": "location",
        "token": "68747470733a2f2f75702e6578616d706c652f707573682f616263",
        "not_after": 1790000900
      },
      "expected": {
        "padded": ""
      }
    },
    {
      "name": "nonzero-padding",
      "inputs": {
        "padded": ""
      },
      "expected": {
        "error": "BadPadding"
      }
    },
    {
      "name": "unknown-platform",
      "inputs": {
        "padded": ""
      },
      "expected": {
        "error": "OutOfRange"
      }
    },
    {
      "name": "unknown-version",
      "inputs": {
        "padded": ""
      },
      "expected": {
        "error": "UnsupportedVersion"
      }
    }
  ]
}
