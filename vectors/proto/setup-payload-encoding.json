      "expected": {
        "error": "OutOfRange"
      }
    },
    {
      "name": "no-gateway-pins",
      "inputs": {
        "encoding": "8201847768747470733a2f2f70696e676572732e6578616d706c657820303132333435363738396162636465663031323334353637383961626364656680825820808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f5820a0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf"
