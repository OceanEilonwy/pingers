{
  "name": "setup-payload-encoding",
  "description": "First-phone setup link payload (https://<server>/j#s1.<base64url(this)>, shown by the owner's appliance as a QR code) as canonical CBOR: [server, registration code (text, 1 to 128 bytes), gateway key pins ([32-byte SHA-256 of the key config], served key first, 1 to 4), push relay key pins (the same, published key first, 1 to 4)]. Inputs give each pin list as the hex of its hashes, concatenated.",
  "vectors": [
    {
      "name": "link",
      "inputs": {
        "server": "https://pingers.example",
        "registration_code": "0123456789abcdef0123456789abcdef",
        "gateway_pins": "101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f",
        "push_relay_pins": "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9fa0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf"
      },
      "expected": {
        "encoding": ""
      }
    },
    {
      "name": "one-pin-each",
      "inputs": {
        "server": "https://pingers.example",
        "registration_code": "0123456789abcdef0123456789abcdef",
        "gateway_pins": "101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f",
        "push_relay_pins": "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f"
      },
      "expected": {
        "encoding": "8201847768747470733a2f2f70696e676572732e6578616d706c6578203031323334353637383961626364656630313233343536373839616263646566815820101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f815820808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f"
      }
    },
    {
