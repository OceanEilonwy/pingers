        "from_latitude": -33.9,
        "from_longitude": 151.2,
        "to_latitude": -33.9,
        "to_longitude": 151.2
      },
      "expected": {
        "distance_meters": 0.0,
        "bearing_degrees": 0.0
      }
    },
    {
      "name": "antipodes",
      "inputs": {
        "from_latitude": 0.0,
        "from_longitude": 0.0,
        "to_latitude": 0.0,
        "to_longitude": 180.0
