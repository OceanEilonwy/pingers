<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The co-presence alert, and what the core returns from a push. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Region map packs, downloaded whole from the map host (android/docs/maps.md). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The platform layer (org.pingers.app.platform, docs/architecture.md section 4):
         Fused Location and the Geofencing API, the location foreground service for
         Meetups and "Keep Pingers running", and geofences registered again after a reboot. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />

    <!-- Nothing is backed up: Parties, Spots, zones and keys stay on this phone. -->
    <application
        android:name=".PingersApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Pingers">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Invite links of the build's own server, https://<server>/j#v1.<invite>: verified
                 App Links (the server serves /.well-known/assetlinks.json), so a tap opens the
                 app without asking. The host comes from PINGERS_SERVER_HOST (any port matches). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${pingersServerHost}"
                    android:pathPrefix="/j" />
            </intent-filter>
            <!-- No filter for other servers' https links (host "*"): such a filter cannot be
                 verified, and on Android 11 and earlier it made the whole app's verification fail
                 (domains "pingers.invalid *", status "ask" on an API 30 emulator, 2026-11-17), so
                 even this server's links, setup links with their registration code included,
                 went to a chooser any app claiming the same links could appear in. Other
                 servers' links open in the browser, whose landing page hands them to this app by
                 package name. -->
            <!-- pingers://join#v1.<invite>: what a server's landing page at /j forwards to (an
                 intent:// URL there carries the invite as the extra "invite" instead). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pingers" android:host="join" />
            </intent-filter>
        </activity>

        <!-- Every notification action (open the Meetup, hide me here, You're in) starts this
             non-exported activity, which hands the action to MainActivity inside the app.
             MainActivity is exported and browsable, so it acts on no extra of its own intent
             (NotificationActions.kt). -->
        <activity
            android:name=".NotificationTrampoline"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Platform layer. The flavours add their geofence receiver (gms: Geofencing API,
             foss: proximity alerts) and, in gms, the FCM service. -->
        <service
            android:name=".platform.LocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".platform.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- UnifiedPush: the connector's manifest brings the distributor <queries>, its
             receiver and WAKE_LOCK; the app declares the service it binds to. -->
        <service
            android:name=".platform.PingersPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
