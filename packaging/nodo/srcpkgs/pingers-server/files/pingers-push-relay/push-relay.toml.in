# pingers-push-relay's configuration, rendered by nodo from pingers-push-relay's settings: change
# them in nodo-tui, not here. The format is crates/pingers-push-relay/src/config.rs.
listen = "127.0.0.1:9472"
operator = "$(pingers-push-relay.operator)"
logging = "$(pingers-push-relay.logging)"
hash_key = "$(pingers-push-relay.hash_key)"
upstream_timeout_ms = 10000
token_pushes_per_minute = 30
max_ttl_s = 2592000

[[keys]]
key_id = "$(pingers-push-relay.key_a_id)"
private_key = "$(pingers-push-relay.key_a)"
activated_at = "$(pingers-push-relay.key_a_activated_at)"
retired_at = "$(pingers-push-relay.key_a_retired_at)"        # TODO(p-relays): 0 = not scheduled

[[keys]]
key_id = "$(pingers-push-relay.key_b_id)"
private_key = "$(pingers-push-relay.key_b)"
activated_at = "$(pingers-push-relay.key_b_activated_at)"
retired_at = "$(pingers-push-relay.key_b_retired_at)"        # TODO(p-relays): 0 = not scheduled

[[servers]]
# This device's pingers-server, the relay's only sender.
server_id = "local"
# The credential itself, hashed under hash_key at load and then zeroized (P8).
credential = "$(pingers-push-relay.server_credential)"       # TODO(p-relays): inline credential
pushes_per_minute = 600

[unifiedpush]
allow_insecure_local_endpoints = false

[fcm]
project_id = "$(pingers-push-relay.fcm_project_id)"
# The service account's JSON, inline (P8): in memory only, never a file on disk.
service_account_json = "$(pingers-push-relay.fcm_service_account)"   # TODO(p-relays): inline JSON
