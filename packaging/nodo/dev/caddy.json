{
  "admin": { "disabled": true },
  "apps": {
    "tls": {
      "certificates": {
        "load_files": [
          { "certificate": "target/dev-ca/leaf.pem", "key": "target/dev-ca/leaf.key", "tags": ["pingers-dev"] }
        ]
      }
    },
    "http": {
      "servers": {
        "server": {
          "listen": ["127.0.0.1:9443"],
          "automatic_https": { "disable": true },
          "tls_connection_policies": [{ "certificate_selection": { "any_tag": ["pingers-dev"] } }],
          "routes": [
            {
              "match": [{ "path": ["/ohttp", "/ohttp/*", "/metrics", "/metrics/*"] }],
              "handle": [{ "handler": "static_response", "status_code": "404" }],
              "terminal": true
            },
            {
              "handle": [{
                "handler": "reverse_proxy",
                "upstreams": [{ "dial": "127.0.0.1:9470" }],
                "transport": { "protocol": "http", "versions": ["h2c"] },
                "flush_interval": -1
              }],
              "terminal": true
            }
          ]
        },
        "ohttp": {
          "listen": ["127.0.0.1:9444"],
          "automatic_https": { "disable": true },
          "tls_connection_policies": [{ "certificate_selection": { "any_tag": ["pingers-dev"] } }],
          "routes": [
            {
              "handle": [{
                "handler": "reverse_proxy",
                "upstreams": [{ "dial": "127.0.0.1:9473" }],
                "transport": { "protocol": "http", "versions": ["h2c"] },
                "flush_interval": -1
              }],
              "terminal": true
            }
          ]
        },
        "push": {
          "listen": ["127.0.0.1:9445"],
          "automatic_https": { "disable": true },
          "tls_connection_policies": [{ "certificate_selection": { "any_tag": ["pingers-dev"] } }],
          "routes": [
            {
              "match": [{ "path": ["/v1/push", "/v1/push/*"] }],
              "handle": [{ "handler": "static_response", "status_code": "404" }],
              "terminal": true
            },
            {
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "127.0.0.1:9472" }] }],
              "terminal": true
            }
          ]
        },
        "maps": {
          "listen": ["127.0.0.1:9446"],
          "automatic_https": { "disable": true },
          "tls_connection_policies": [{ "certificate_selection": { "any_tag": ["pingers-dev"] } }],
          "routes": [
            {
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "127.0.0.1:9474" }] }],
              "terminal": true
            }
          ]
        }
      }
    }
  }
}
